{
	"name": "stagemedia",
	"version": "1.0.1",
	"description": "Показ фото и видео на проекторе для концертов",
	"main": "src/main/main.js",
	"author": "MixFix",
	"scripts": {
		"start": "electron .",
		"dist": "electron-builder --win portable"
	},
	"devDependencies": {
		"electron": "^45.2.1",
		"electron-builder": "^25.1.8"
	},
	"build": {
		"appId": "com.concert.stagemedia",
		"productName": "StageMedia",
		"files": [
			"src/**/*",
			"package.json",
			"icon.ico",
			"node_modules/discord-rpc/**/*"
		],
		"win": {
			"icon": "icon.ico",
			"target": [
				{
					"target": "portable",
					"arch": [
						"x64"
					]
				}
			]
		},
		"portable": {
			"artifactName": "StageMedia.exe"
		}
	},
	"dependencies": {
		"discord-rpc": "^4.0.1"
	}
}
